# Specify default ExifTool API options
# (see the Options function documentation for available options)
%Image::ExifTool::UserDefined::Options = (
LargeFileSupport => 1,
Geolocation => 1,
Lang => es
);


# CUSTOM NAMESPACE & COMPOSITE TAGS
%Image::ExifTool::UserDefined = (
	# CUSTOM TAGS - New XMP namespace must be added to the Main XMP table:
    'Image::ExifTool::XMP::Main' => {
        AMC => {
		    Writable => 'string',
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::AMC'
            }
        }
    },

	# COMPOSITE TAGS
    'Image::ExifTool::Composite' => {
		#Hash
		MD5 => {
            Desire => {
                1 => 'ImageDataHash',
            },

            ValueConv => q{
                my $md5 = $val[0];
                return "${md5}";
            },
        },
		#Make by priority
		MyMake => {
            Desire => {
                0 => 'Make',
                1 => 'AndroidMake',
            },
            ValueConv => '$val[0] || $val[1]',
        },
		#Model by priority
		MyModel => {
            Desire => {
                0 => 'Model',
                1 => 'AndroidModel',
            },
            ValueConv => '$val[0] || $val[1]',
        },
		MySerialNumber => {
			Desire => {
				0 => 'InternalSerialNumber',
			},
			ValueConv => q{
	
				my $SerialNumber = CleanSerialNumber($val[0]);
				return "${SerialNumber}";
			},
		},
		MyAuthorName => {
			Require => {
				0 => 'MyModel',
				1 => 'MyDate',
			},
			Desire => {
				2 => 'MySerialNumber',
			},
			ValueConv => q{
				 my $author = GetAuthor($val[0], $val[1], $val[2]);
				 if ($author) {
					return $author->{'Name'};
				 }
			},
		},
        MyAuthorAlias => {
			Require => {
				0 => 'MyModel',
				1 => 'MyDate',
			},
			Desire => {
				2 => 'MySerialNumber',
			},
			ValueConv => q{
				 my $author = GetAuthor($val[0], $val[1], $val[2]);
				 if ($author) {
					return $author->{'Alias'};
				 }
			},
		},
		MyDeviceName => {
			Require => {
				0 => 'MyModel',
			},
			Desire => {
				1 => 'MySerialNumber',
			},
			ValueConv => q{
				my $device = GetDevice($val[0], $val[1]);
				if ($device) {
					return $device->{'Name'};
				}
			},
		},
		MyDeviceAlias => {
			Require => {
				0 => 'MyModel',
			},
			Desire => {
				1 => 'MySerialNumber',
			},
			ValueConv => q{
				my $device = GetDevice($val[0], $val[1]);
				if ($device) {
					return $device->{'Alias'};
				}
			},
		},
		
		#FileType

		IsVideo => {
			ValueConv => q{
				return $$self{VALUE}{FileTypeExtension} =~ /^(mp4|mov|3gp|avi|mkv|webm|flv)$/i ? 1 : 0;
			},
		},

		IsPhoto => {
			ValueConv => q{
				return $$self{VALUE}{FileTypeExtension} =~ /^(jpe?g|png|tif|tiff|cr2|nef|arw|rw2|raf)$/i ? 1 : 0;
			},
		},

		#Event
		MyAlbum => {
			Require => {
				0 => 'MyDate',
			},
			Desire => {
                1 => 'Album',
            },
            ValueConv => q{
				 my $date = $val[0];
				 my $AlbumOriginal = $val[1];
				 my $Album;
				 my $DefaultAlbumFolderName = "Moments";
				 
				 # Comprobar si el nodo de álbum tiene un valor definido en los metadatos
				 if ($AlbumOriginal) {
				 	$Album = $AlbumOriginal;
				 } else {
				 	# Si no hay valor, usar la convención predeterminada
				 	$self->Options(DateFormat => "%Y-%m");
					$date = $self->ConvertDateTime($date);
					$Album = "${date} ${DefaultAlbumFolderName}" #2021-01 Moments"
				 }

			     $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
			
				 return "${Album}";
			},
        },
		MyDecade => {
            Require => {
                0 => 'MyDate',
            },
            ValueConv => q{
				my $date = $val[0];
				$self->Options(DateFormat => "%Y");
				$date = $self->ConvertDateTime($date);
				$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				$date =~ s/\d$//;  #Remove last digit
                my $decade = "${date}0";
                return $decade;
            },
        },
		
		#Date by priority
		MyDate => {
			Desire => {
				0 => 'DateTimeOriginal',
				1 => 'CreateDate',
				2 => 'ModifyDate',
				3 => 'XMP-AMC:OriginOriginalDateTime', # Tu tag de persistencia (Máxima prioridad después de EXIF estándar)
				4 => 'DateTimeOriginalFromFileName',
				5 => 'FileModifyDate',               # Último recurso
			},
			ValueConv => q{
				my $date;
				my $fallback;

				# 1. Bucle de Filtrado: Busca la primera fecha perfecta y atrapa la primera fecha "sospechosa"
				foreach my $v (@val) {
					next unless $v;
					next if $v =~ /^0000/;
			
					# Atrapa fechas sospechosas (1900-1959) como fallback, pero sigue buscando.
					if ($v =~ /^19[0-5]\d/) {
						$fallback = $v if !defined $fallback; 
						next;
					}
            
					# Si pasa los filtros, esta es la fecha de máxima prioridad.
					$date = $v;
					last;
				}

				# 2. Respaldo Final
				# Se usa si $date sigue vacío:
				# Primero: Nombre del archivo ($val[4]), 
				# Segundo: El fallback sospechoso ($fallback), 
				# Tercero: Fecha del sistema ($val[5]).
				$date ||= $val[4] || $fallback || $val[5]; 

				$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); 
				return $self->ConvertDateTime($date);
			},
		},

		MyGPSOffset => {
			Require => {
				0 => 'DateTimeOriginal', # Hora Local Ingenua: 2013:12:08 18:42:17
				1 => 'GPSDateTime',      # Hora UTC: 2013:12:08 17:42:15
			},
			ValueConv => q{
				my $local_time = $val[0];
				my $utc_time_full = $val[1];
        
				# Obtener el tiempo Unix (segundos desde 1970-01-01 00:00:00 UTC)
				my $local_utime = Image::ExifTool::GetUnixTime($local_time);
				my $utc_utime = Image::ExifTool::GetUnixTime($utc_time_full);
        
				# Calcular la diferencia de tiempo en segundos (Local - UTC)
				# Esto debería dar 3602 segundos (1 hora y 2 segundos)
				my $offset_seconds = $local_utime - $utc_utime;
        
				# ¡CORRECCIÓN CLAVE! Convertir la diferencia de segundos a formato HH:MM
				# La función TimeZoneString de ExifTool está diseñada para esto.
				# Devuelve el offset en minutos, así que necesitamos dividir por 60.
				my $offset_minutes = int($offset_seconds / 60);

				# Asegúrate de que el formato sea el correcto (+HH:MM)
				# Usaremos la función interna GetTimeZoneString para el formato correcto.

				my $offset_string;
				if ($offset_minutes % 60 == 0) {
					# Si el offset es una hora exacta (e.g., 60, 120, -180 min)
					my $hours = $offset_minutes / 60;
					$offset_string = sprintf("%+03d:00", $hours); # e.g. +01:00
				} else {
					# Si hay minutos (lo cual es raro, pero posible)
					my $hours = int($offset_minutes / 60);
					my $minutes = abs($offset_minutes % 60);
					$offset_string = sprintf("%+03d:%02d", $hours, $minutes); # e.g. +01:30
				}
        
				return $offset_string; # Esto debería devolver "+01:00"
			},
		},

		MyTimeZoneOffset => {
			# Usamos las fuentes de TZ más fiables, incluyendo tu tag de persistencia
			Desire => {
				0 => 'MyGPSOffset', 
				1 => 'OffsetTimeOriginal',
				2 => 'TimeZone',
				3 => 'OffsetTime',
				4 => 'XMP-AMC:OriginOriginalTimeZoneOffset', 
				5 => 'FileModifyDate',
			},
			ValueConv => q{
				# Iteramos sobre los valores buscando un formato de offset explícito
				for (my $i = 0; $i < @val; $i++) {
					next unless $val[$i];
            
					# Patrón para formatos de offset (+HH:MM o -HH:MM)
					if ($val[$i] =~ /^(\+\d{2}:\d{2}|-\d{2}:\d{2})$/) {
						return $1;
					}
            
					# Patrón para formatos de fecha completa que incluyen offset
					if ($val[$i] =~ /(\+\d{2}:\d{2}|-\d{2}:\d{2})/) {
						return $1;
					}
				}
		
				# Si no se encuentra un offset explícito en los tags dedicados, 
				# se devuelve vacío, y C# deberá asumir la hora local del sistema.
				return undef; 
			},
		},

		MyDateTimeLocalOffset => {
			Require => {
				0 => 'MyDate',
			},
			Desire => {
				1 => 'MyTimeZoneOffset',
			},
			ValueConv => q{
				my $date = $val[0];
				my $offset = $val[1] || '+00:00'; # Fallback a +00:00 si no hay offset explícito.
				
				# Combina la fecha naive con el offset (e.g., 2024:03:02 10:00:52+01:00)
				return "$date$offset"; 
			},
		},

		MyDateTimeUTC => {
			Require => {
				0 => 'MyDate',
				1 => 'MyTimeZoneOffset',
			},
			ValueConv => q{
				my $naive_date = $val[0];
				my $offset = $val[1];

				unless ($offset) {
					return undef;
				}
				
				# Llamada a la función privada que realiza el cálculo de zona horaria
				return ConvertDateTimeToUTC($self, $naive_date, $offset);
			},
		},		

		MyShortMonthName => {
			Require => {
					0 => 'MyDate',
			},
			ValueConv => q{
				 my $date = $val[0];
				 $self->Options(DateFormat => "%b");
				 $date = $self->ConvertDateTime($date);
				 $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				 $date =~ s/(\b\w)/\u$1/g;  # Capitalizar la primera letra del mes
				 $date =~ s/\.//;           # Eliminar el punto del mes abreviado
				 return "${date}";
			},
		},
        MySubseconds => {
            ValueConv => q{
				my ($self) = @_;
				#SubSecTimeOriginal - Variable original subsegundos
				my $subsectimeoriginal = $self->GetValue('SubSecTimeOriginal');
				#SubsecondsFromFileName - Variable obtenida de nombre
				my $SubsecondsFromFileName = $self->GetValue('SubsecondsFromFileName');
				return GetSubSeconds($subsectimeoriginal, $SubsecondsFromFileName);
            },
        },
		SubsecondsFromFileName => {
			Desire => {
				0 => 'PreservedFileName',
				1 => 'FileName',
			},
            ValueConv => q{
				my $OriginalFileName = $val[0] || $val[1];
				my $TZReferencedDateTime = $self->GetValue('CreateDate');
				my ($date, $hour, $min, $sec, $subseconds) = GetDateTimeOriginalFromFileName($self, $OriginalFileName, $TZReferencedDateTime);
				return $subseconds;
            },
        },
		DateTimeOriginalStringFromFileName => {
			#Condition => 'not defined $$self{VALUE}{DateTimeOriginal} and $$self{VALUE}{FileTypeExtension} =~ /^(mp4|JPG)$/i',
			Desire => {
				0 => 'PreservedFileName',
				1 => 'FileName',
			},
			ValueConv => q{
				my $OriginalFileName = $val[0] || $val[1];
				my $TZReferencedDateTime = $self->GetValue('CreateDate');
				my ($date, $hour, $min, $sec, $subseconds) = GetDateTimeOriginalFromFileName($self, $OriginalFileName, $TZReferencedDateTime);
				
				return "$date $hour:$min:$sec.$subseconds";
			},
            #PrintConv => '$self->ConvertDateTime($val)',
		},
		DateTimeOriginalFromFileName => {
			#Condition => 'not defined $$self{VALUE}{DateTimeOriginal} and $$self{VALUE}{FileTypeExtension} =~ /^(mp4|JPG)$/i',
			Desire => {
				0 => 'PreservedFileName',
				1 => 'FileName',
			},
			ValueConv => q{
				my $OriginalFileName = $val[0] || $val[1];
				my $TZReferencedDateTime = $self->GetValue('CreateDate');
				my ($date, $hour, $min, $sec, $subseconds) = GetDateTimeOriginalFromFileName($self, $OriginalFileName, $TZReferencedDateTime);
				
				my $full_date = "$date $hour:$min:$sec";
				$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				return $self->ConvertDateTime($full_date);
			},
            #PrintConv => '$self->ConvertDateTime($val)',
		},

		#Name convention
		MyFullFolderFileConvention => {
			Require => {
					0 => 'MyFolderConvention',
					1 => 'MyFileNameConvention',
			},
			ValueConv => q{
				 my $FolderConvention = $val[0];
				 my $FileNameConvention = $val[1];
				 #print "MyFullFolderFileConvention: ${FolderConvention}/${FileNameConvention}";
				 return "${FolderConvention}/${FileNameConvention}";
			},
		},
		MyFileNameConvention => {
			Require => {
					0 => 'MyDate',
					1 => 'MySubseconds',
					2 => 'MyModel',
					3 => 'MyAuthorAlias',
					4 => 'MyDeviceAlias',
			},
			Desire => {
				5 => 'MySerialNumber',
			},
			ValueConv => q{
				 my $date = $val[0];
				 my $Subseconds = $val[1];
				 my $model = $val[2];
				 my $AuthorAlias = $val[3];
				 my $DeviceAlias = $val[4];
				 my $serialNumber = $val[5];
				
				 
				 # Formatear la fecha
				 $self->Options(DateFormat => "%Y-%m-%d_%H-%M-%S");
				 $date = $self->ConvertDateTime($date);
				 $date =~ s/(\b\w)/\u$1/g;  # Capitalizar la primera letra del mes
				 $date =~ s/\.//;           # Eliminar el punto del mes abreviado
				 $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				 
				 return "${date}-${Subseconds}-${AuthorAlias}-${DeviceAlias}"; #YYYY-MM-DD_HH-mm-ss-mss_Author_Device(2024-03-01_19-02-48-050_AMC_PXL8P)
			},
		},
		MyFolderConvention => {
			Require => {
					0 => 'MyDate',
					1 => 'MyDecade',
					2 => 'MyShortMonthName',
					3 => 'MyAlbum',
			},
			ValueConv => q{
				 my $date = $val[0];
				 my $MyDecade = $val[1];
				 my $MyShortMonthName = $val[2];
				 my $Album = $val[3];
				 $self->Options(DateFormat => "%Y/%Y-%m");
				 $date = $self->ConvertDateTime($date);
				 $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				 return "${MyDecade}s/${date}-${MyShortMonthName}/${Album}"; #Y0s\YYYY\Year-MonthNumber-MyShortMonthName\Album (2020s\2021\2021-01-Jan\2021-01 Moments)
			},
		},
		TrackCreateDate => {
			Desire => {
				0 => 'QuickTime:TrackCreateDate',
			},
			ValueConv => q{
				# Recorremos la lista de valores encontrados por ExifTool (@val)
				# Esto asegura que no devolvamos el HASH o ARRAY de referencia
				foreach my $v (@val) { 
					return $v if $v; # Devolvemos el primer valor válido
				}
				return undef;
			},
		},
		TrackModifyDate => {
			Desire => {
				0 => 'QuickTime:TrackModifyDate',
			},
			ValueConv => q{
				# Recorremos la lista de valores encontrados por ExifTool (@val)
				# Esto asegura que no devolvamos el HASH o ARRAY de referencia
				foreach my $v (@val) { 
					return $v if $v; # Devolvemos el primer valor válido
				}
				return undef;
			},
		},
		MediaCreateDate => {
			Desire => {
				0 => 'QuickTime:MediaCreateDate',
			},
			ValueConv => q{
				# Recorremos la lista de valores encontrados por ExifTool (@val)
				# Esto asegura que no devolvamos el HASH o ARRAY de referencia
				foreach my $v (@val) { 
					return $v if $v; # Devolvemos el primer valor válido
				}
				return undef;
			},
		},
		TrackModifyDate => {
			Desire => {
				0 => 'QuickTime:MediaModifyDate',
			},
			ValueConv => q{
				# Recorremos la lista de valores encontrados por ExifTool (@val)
				# Esto asegura que no devolvamos el HASH o ARRAY de referencia
				foreach my $v (@val) { 
					return $v if $v; # Devolvemos el primer valor válido
				}
				return undef;
			},
		},
    },

	# SHORTCUT TAGS (Para agrupar tags de escritura y lectura)
    'Image::ExifTool::UserDefined::Shortcuts' => {
        VidTime => [
            'Quicktime:CreateDate',
            'Quicktime:ModifyDate',
            'Quicktime:TrackCreateDate',
            'Quicktime:TrackModifyDate',
            'Quicktime:MediaCreateDate',
            'Quicktime:MediaModifyDate',
        ],
        SysTime => [
            'FileCreateDate',
            'FileModifyDate',
        ],
		MyCustomQuickTimeTrackCreateDate => 'TrackCreateDate',
	},
);

# CUSTOM NAMESPACE DEFINITION (AMC)
# Define la estructura XMP anidada para ns.amarcobal.es/AMC/1.0/
#
%Image::ExifTool::UserDefined::AMC = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-AMC', 2 => 'Image' },
    NAMESPACE => { 'AMC' => 'http://ns.amarcobal.es/AMC/1.0/' },
    WRITECUSTOM => 1,
    
    # ---------------------------------------------------------------------
    # ESTRUCTURA 1: IDENTITY
    # ---------------------------------------------------------------------
    Identity => {
        Writable => 'struct', # Clave para la escritura de estructuras no-lista
        Struct => {
            STRUCT_NAME => 'Identity', # Nombre para diagnóstico
            
            # 1.1 Estructura Anidada: Author
            Author => {
                Writable => 'struct', 
                Struct => {
                    STRUCT_NAME => 'Author', 
                    ID    => { Writable => 'string' },
                    Alias => { Writable => 'string' },
                    Name  => { Writable => 'string' },
                },
            },
            
            # 1.2 Estructura Anidada: Device
            Device => {
                Writable => 'struct', 
                Struct => {
                    STRUCT_NAME => 'Device', 
                    ID           => { Writable => 'string' },
                    Alias        => { Writable => 'string' },
                    Name         => { Writable => 'string' },
                    SerialNumber => { Writable => 'string' },
                },
            },
        },
    }, # Fin de Identity

    # ---------------------------------------------------------------------
    # ESTRUCTURA 2: ORIGIN
    # ---------------------------------------------------------------------
    Origin => {
        Writable => 'struct',
        Struct => {
            STRUCT_NAME => 'Origin',
            OriginalFileName         => { Writable => 'string' },
            OriginalFolder           => { Writable => 'string' },
            OriginalDateTime         => { Writable => 'string' }, # Fecha canónica (Local + Offset)
			OriginalDateTimeLocal	 => { Writable => 'string' }, # Fecha Naive (sin offset)
			OriginalDateTimeUTC      => { Writable => 'string' }, # Fecha UTC
			OriginalTimeZoneOffset   => { Writable => 'string' }, # Offset de zona horaria
            OriginalSubseconds       => { Writable => 'string' },
        },
    }, # Fin de Origin

    # ---------------------------------------------------------------------
    # ESTRUCTURA 3: EVENT
    # ---------------------------------------------------------------------
    Event => {
        Writable => 'struct',
        Struct => {
            STRUCT_NAME => 'Event',
            Name => { Writable => 'string' },
            StartDate => { Writable => 'string' },
            EndDate   => { Writable => 'string' },
            HierarchyPath => { Writable => 'string' },
        },
    }, # Fin de Event
);



