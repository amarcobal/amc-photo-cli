  "DayFormat": "dd",
  "DateFormatWithMonth": "yyyy-MM",
  "DateFormatWithDay": "yyyy-MM-dd",
  "DateTimeFormatWithMinutes": "yyyy-MM-dd_HH-mm",
  "DateTimeFormatWithSeconds": "yyyy-MM-dd_HH-mm-ss",
  "PhotoFormatInvalidFolderName": "invalid-photo-format",
  "NoPhotoTakenDateFolderName": "no-photo-taken-date",
  "NoAddressFolderName": "no-address",
  "NoAuthorFolderName": "no-author",
  "NoDeviceFolderName": "no-device",
  "NoAddressAndPhotoTakenDateFolderName": "no-address-and-no-photo-taken-date",
  "NoAuthorAndPhotoTakenDateFolderName": "no-author-and-no-photo-taken-date",
  "NoDeviceAndPhotoTakenDateFolderName": "no-device-and-no-photo-taken-date",
  "NoAuthorAndDeviceAndPhotoTakenDateFolderName": "no-author-and-no-device-and-no-photo-taken-date",
  "NoAuthorAndDeviceFolderName": "no-author-and-no-device",
