# PRIVATE METHODS (Fill Composite Tags)

sub ResetDateFormatGlobal {
    $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
}

sub GetDevice {
    my ($model, $serial_number) = @_;
    my $device;

    # Buscar en la lista de dispositivos por número de serie
    foreach my $dev (keys %Devices) {
        if ($serial_number && $serial_number eq $Devices{$dev}->{'Serialnumber'}) {
            $device = $Devices{$dev};
            #print "Dispositivo encontrado por número de serie: $dev\n"; # Imprimir el dispositivo encontrado
            return $device;  # Salir del bucle si se encuentra el dispositivo
        }
    }

    # Si no se encontró por número de serie, buscar por modelo
    foreach my $dev (keys %Devices) {
        if ($model eq $Devices{$dev}->{'Model'}) {
            $device = $Devices{$dev};
            #print "Dispositivo encontrado por modelo: $dev\n"; # Imprimir el dispositivo encontrado
            return $device;  # Salir del bucle si se encuentra el dispositivo
        }
    }

    return $device;
}

sub GetAuthor {
    my ($model, $datetime_original, $serial_number) = @_;
    my $authorFound;
    my $device = GetDevice($model, $serial_number);
	#print "Dispositivo Author: ${device}";
    if ($device) {
        # Buscar en la lista de autores
        foreach my $author (keys %Authors) {
            foreach my $dev (keys %{$Authors{$author}->{'Devices'}}) {
				#print "ID Dispositivo: $device->{'ID'}\n";
				#print "ID Dispositivo Autor: $device->{'ID'}\n";
                if ($device->{'ID'} eq $dev) {
                    my $from_date = $Authors{$author}->{'Devices'}->{$dev}->{'From'};
                    my $to_date = $Authors{$author}->{'Devices'}->{$dev}->{'To'};
					#print "Fecha From: $from_date\n";
					#print "Fecha To: $to_date\n";
                    if (CheckDateRange($datetime_original, $from_date, $to_date)) {
                        $authorFound = $Authors{$author};
                    }
                }
            }
        }
    }
    return $authorFound;
}

sub GetAuthorAlias {
    my ($model, $datetime_original, $serial_number) = @_;
    my $alias;
    my $author = GetAuthor($model, $datetime_original, $serial_number);
    if ($author) {
        $alias = $author->{'Alias'};
    }
    return $alias;
}

sub GetDeviceAlias {
    my ($model, $serial_number) = @_;
    my $alias;
    my $device = GetDevice($model, $serial_number);
    if ($device) {
        $alias = $device->{'Alias'};
    }
    return $alias;
}

sub CheckDateRange {
    my ($date_to_check, $from_date, $to_date) = @_;

    # Convertir las fechas a objetos DateTime
    my $check_time = Image::ExifTool::GetUnixTime($date_to_check);
    my $from_time = $from_date ? Image::ExifTool::GetUnixTime($from_date) : undef;
    my $to_time = $to_date ? Image::ExifTool::GetUnixTime($to_date) : undef;

    # Comprobar si la fecha está dentro del rango
    if ($check_time >= $from_time && (!$to_time || $check_time <= $to_time)) {
	return 1;
	}
	return 0;
	}

	sub CleanSerialNumber {
	my ($string) = @_;
	$string =~ s/[^\x20-\x7E]+$//;
	#my $length_serial = length($string);
	#print "Longitud del trim: $length_serial\n";
	#for my $char (split //, $string) {
	#    printf "%s -> %d\n", $char, ord($char);
	#}

	return $string;
	}


	sub GetSubSeconds {
	my ($subsectimeoriginal, $SubsecondsFromFileName) = @_;
	my $subseconds;

	if ($subsectimeoriginal) {
	# Recortar el valor de subsectimeoriginal a 3 caracteres
	$subseconds = substr($subsectimeoriginal, 0, 3);
	}
	elsif ($SubsecondsFromFileName) {
	$subseconds = $SubsecondsFromFileName;
	}
	else {
	$subseconds = "";
	}
	# print "Entramos en subseconds: $subseconds\n";

	return $subseconds;
	}

	sub GetDateTimeOriginalFromFileNameCopy {
		my ($OriginalFileName) = @_;

		# Extraer la fecha, la hora y los subsegundos del nombre del archivo
		my $date;
		my $hour;
		my $min;
		my $sec;
		my $subseconds;
		my $timezone;
		if ($OriginalFileName =~ /(\d{4})(\d{2})(\d{2})_(\d{2})(\d{2})(\d{2})(\d{3})?/) {
		$date = "$1:$2:$3";
		$hour = "$4";
		$min = "$5";
		$sec = "$6";
		$subseconds = $7 // "000"; # Si no hay subsegundos, establecerlos en "000"
		} elsif ($OriginalFileName =~ /(\d{8})_(\d{6})(\d{3})?.*/) {
		$date = substr($1, 0, 4) . ':' . substr($1, 4, 2) . ':' . substr($1, 6, 2);
		$hour = substr($2, 0, 2);
		$min = substr($2, 2, 2);
		$sec = substr($2, 4, 2);
		$subseconds = $3 // "000"; # Si no hay subsegundos, establecerlos en "000"
		} else {
		# Si el nombre del archivo no coincide con ningún patrón, devolver undef
		return undef;
		}

		# Devolver múltiples valores en forma de lista
		return ($date, $hour, $min, $sec, $subseconds);
		}

		sub GetDateTimeOriginalFromFileName {
		my ($self, $OriginalFileName, $TimeZoneReferencedDateTime) = @_;

		# Extraer la fecha, la hora y los subsegundos del nombre del archivo
		my ($date, $hour, $min, $sec, $subseconds) = InternalGetDateTimeOriginalFromFileName($OriginalFileName);

		# Calcular el desfase horario en minutos y redondear el resultado a un número entero
		$timezone = int(Image::ExifTool::TimeZoneString(
		Image::ExifTool::GetUnixTime($TimeZoneReferencedDateTime) -
		Image::ExifTool::GetUnixTime("$date $hour:$min:$sec")
		) / 60);
		#print "TimeZone: $timezone\n";

		# Agregar el desfase horario (en segundos) a la fecha y hora original
		my $adjusted_time = Image::ExifTool::GetUnixTime("$date $hour:$min:$sec.$subseconds") + $timezone * 60 * 60;

		# Formatear la fecha y la hora en el formato deseado
		#my $adjusted_time2 = $self->ConvertDateTime(Image::ExifTool::ConvertUnixTime($adjusted_time));

		my $adjusted_time = Image::ExifTool::ConvertUnixTime($adjusted_time);

		my $formated_date_time = $self->ConvertDateTime($adjusted_time);

		#Extract Date
		$self->Options(DateFormat => "%Y:%m:%d");
		$date = $self->ConvertDateTime($formated_date_time);

		#Extract Hour
		$self->Options(DateFormat => "%H");
		$hour = $self->ConvertDateTime($formated_date_time);

		#Extract Min
		$self->Options(DateFormat => "%M");
		$min = $self->ConvertDateTime($formated_date_time);

		#Extract Second
		$self->Options(DateFormat => "%S");
		$sec = $self->ConvertDateTime($formated_date_time);

		$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat

		#Extract Subseconds (Original)

		#print "GetDateTimeOriginalFromFileName Formated Date: $formated_date_time\n";
		#print "Date Formated Date: $date\n";
		#print "Hour Formated Date: $hour\n";
		#print "Min Formated Date: $min\n";
		#print "Sec Formated Date: $sec\n";
		#print "Subsec Formated Date: $subseconds\n";

		return ($date, $hour, $min, $sec, $subseconds);
	}

	sub InternalGetDateTimeOriginalFromFileName {
		my ($OriginalFileName) = @_;

		# Extraer la fecha, la hora y los subsegundos del nombre del archivo
		my $date;
		my $hour;
		my $min;
		my $sec;
		my $subseconds;

		if ($OriginalFileName =~ /(\d{4})(\d{2})(\d{2})_(\d{2})(\d{2})(\d{2})(\d{3})?/) {
		$date = "$1:$2:$3";
		$hour = "$4";
		$min = "$5";
		$sec = "$6";
		$subseconds = $7 // "000"; # Si no hay subsegundos, establecerlos en "000"
		} elsif ($OriginalFileName =~ /(\d{8})_(\d{6})(\d{3})?.*/) {
		$date = substr($1, 0, 4) . ':' . substr($1, 4, 2) . ':' . substr($1, 6, 2);
		$hour = substr($2, 0, 2);
		$min = substr($2, 2, 2);
		$sec = substr($2, 4, 2);
		$subseconds = $3 // "000"; # Si no hay subsegundos, establecerlos en "000"
		} else {
		# Si el nombre del archivo no coincide con ningún patrón, devolver undef
		return undef;
		}

		# Devolver múltiples valores en forma de lista
		return ($date, $hour, $min, $sec, $subseconds);
	}

	sub ConvertDateTimeToUTC {
		my ($self, $naive_date, $offset) = @_;

		# 1. CALCULAR MANUALMENTE EL OFFSET EN SEGUNDOS
		my ($sign, $h, $m);
		if ($offset =~ /([+-])(\d{2}):(\d{2})/) {
			$sign = $1;
			$h = $2;
			$m = $3;
		} else {
			# Fallo en el formato, devolvemos undef.
			return undef;
		}

		my $offset_seconds = ($h * 3600) + ($m * 60);

		if ($sign eq '-') {
			$offset_seconds = -$offset_seconds; # El offset es negativo
		}

		# 2. Obtener el tiempo UNIX de la fecha NAIVE
		# Se asume que $naive_date está en la zona local, por lo que GetUnixTime
		# calcula un tiempo UNIX incorrecto (no UTC) si se ejecuta en una zona diferente.
		my $naive_unix_time = Image::ExifTool::GetUnixTime($naive_date);

		# 3. Realizar la resta matemática (corrección para obtener el UTC verdadero)
		# Si $offset es +3600s, restamos 3600s.
		my $utc_unix_time = $naive_unix_time - $offset_seconds;
	
		# 4. Formatear el tiempo UTC (segundos absolutos) a string
		# Usamos el método de objeto ConvertUnixTime para formatear la hora
		# (ya corregida matemáticamente) al string deseado.
		$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); 
		my $utc_date_naive = Image::ExifTool::ConvertUnixTime($utc_unix_time);
	
		$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
	
		# 5. Devolver el tiempo UTC con el sufijo ' Z'
		return "$utc_date_naive Z";
	}

	1; # Fin del archivo de configuración
