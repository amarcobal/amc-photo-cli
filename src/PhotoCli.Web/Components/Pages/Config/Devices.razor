@page "/config/devices"
@rendermode InteractiveServer
@using System.IO.Abstractions
@using Microsoft.Extensions.Configuration
@using System.IO
@using YamlDotNet.Serialization
@using PhotoCli.Core.Models
@inject IFileSystem FileSystem
@inject ISnackbar Snackbar
@inject IConfiguration Configuration

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <MudGrid>
        <MudItem xs="8">
            <MudText Typo="Typo.h4" GutterBottom="true" Color="Color.Primary">
                <MudIcon Icon="@Icons.Material.Filled.CameraAlt" Class="mr-2" />
                Dispositivos
            </MudText>
            <MudText Typo="Typo.subtitle1">
                Configura las cámaras y móviles para mapearlos en la identidad de los metadatos.
            </MudText>
        </MudItem>
        <MudItem xs="4" Class="d-flex justify-end align-center">
            <MudSwitch T="bool" Value="@_isRawMode" ValueChanged="OnModeChanged" Label="Modo Código (YAML)" Color="Color.Secondary" Size="Size.Large" />
        </MudItem>
    </MudGrid>

    @if (_isLoading)
    {
        <MudProgressCircular Color="Color.Primary" Indeterminate="true" Class="mt-6" />
    }
    else
    {
        <MudCard Elevation="3" Class="mt-4">
            <MudCardContent>
                @if (_isRawMode)
                {
                    <MudTextField @bind-Value="_content"
                                  Variant="Variant.Outlined"
                                  Lines="20"
                                  Style="font-family: monospace; font-size: 0.9rem; background-color: #1e1e1e; color: #d4d4d4; padding: 12px;" />
                }
                else
                {
                    <MudTable Items="@_devices" Dense="true" Hover="true" Elevation="0"
                              CanCancelEdit="true"
                              EditTrigger="TableEditTrigger.EditButton"
                              RowEditPreview="BackupItem"
                              RowEditCancel="ResetItemToOriginalValues"
                              RowEditCommit="ItemHasBeenCommitted">
                        <ToolBarContent>
                            <MudText Typo="Typo.h6">Lista de Dispositivos</MudText>
                            <MudSpacer />
                            <MudButton Color="Color.Success" StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" OnClick="AddDevice">
                                Nuevo Dispositivo
                            </MudButton>
                        </ToolBarContent>

                        <HeaderContent>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Alternativos</b></MudText></MudTh>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>ID</b></MudText></MudTh>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Nombre (Name)</b></MudText></MudTh>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Alias</b></MudText></MudTh>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Marca (Make)</b></MudText></MudTh>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Modelo (Model)</b></MudText></MudTh>
                            <MudTh><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Nº Serie</b></MudText></MudTh>
                            <MudTh Style="text-align:right"><MudText Typo="Typo.subtitle2" Color="Color.Primary"><b>Acciones</b></MudText></MudTh>
                        </HeaderContent>

                        <RowTemplate>
                            <MudTd>
                                <MudIconButton Icon="@(context.ShowDetails ? Icons.Material.Filled.KeyboardArrowUp : Icons.Material.Filled.KeyboardArrowDown)"
                                               Color="Color.Info" Size="Size.Small"
                                               OnClick="@(() => context.ShowDetails = !context.ShowDetails)" />
                            </MudTd>
                            <MudTd DataLabel="ID"><b>@context.ID</b></MudTd>
                            <MudTd DataLabel="Nombre">@context.Name</MudTd>
                            <MudTd DataLabel="Alias">@context.Alias</MudTd>
                            <MudTd DataLabel="Marca">@context.Make</MudTd>
                            <MudTd DataLabel="Modelo">@context.Model</MudTd>
                            <MudTd DataLabel="Nº Serie">@context.SerialNumber</MudTd>
                            <MudTd DataLabel="Acciones" Style="text-align:right">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(async () => await DeleteDevice(context))" />
                            </MudTd>
                        </RowTemplate>

                        <RowEditingTemplate>
                            <MudTd></MudTd>
                            <MudTd DataLabel="ID"><MudTextField @bind-Value="context.ID" Required="true" RequiredError="Obligatorio" /></MudTd>
                            <MudTd DataLabel="Nombre"><MudTextField @bind-Value="context.Name" Required="true" RequiredError="Obligatorio" /></MudTd>
                            <MudTd DataLabel="Alias"><MudTextField @bind-Value="context.Alias" Required="true" RequiredError="Obligatorio" /></MudTd>
                            <MudTd DataLabel="Marca"><MudTextField @bind-Value="context.Make" Required="true" RequiredError="Obligatorio" /></MudTd>
                            <MudTd DataLabel="Modelo"><MudTextField @bind-Value="context.Model" Required="true" RequiredError="Obligatorio" /></MudTd>
                            <MudTd DataLabel="Nº Serie"><MudTextField @bind-Value="context.SerialNumber" /></MudTd>
                            <MudTd></MudTd>
                        </RowEditingTemplate>

                        <ChildRowContent>
                            @if (context.ShowDetails)
                            {
                                <MudTr>
                                    <td colspan="8" style="padding: 16px; background-color: #2a2a2a; border-left: 4px solid #4caf50;">
                                        <MudText Typo="Typo.subtitle2" Class="mb-4">Nombres Alternativos (EXIF) de <b>@context.Name</b></MudText>
                                        <MudGrid>
                                            <MudItem xs="12" md="6">
                                                <MudTextField @bind-Value="context.AltMakesString"
                                                              Label="Marcas alternativas (AltMakes)"
                                                              HelperText="Separadas por comas (Ej: XIAOMI, Google)"
                                                              Variant="Variant.Outlined"
                                                              OnBlur="@(async () => await AutoSave())" />
                                            </MudItem>
                                            <MudItem xs="12" md="6">
                                                <MudTextField @bind-Value="context.AltModelsString"
                                                              Label="Modelos alternativos (AltModels)"
                                                              HelperText="Separados por comas (Ej: 2201123G, MI 8)"
                                                              Variant="Variant.Outlined"
                                                              OnBlur="@(async () => await AutoSave())" />
                                            </MudItem>
                                        </MudGrid>
                                    </td>
                                </MudTr>
                            }
                        </ChildRowContent>
                    </MudTable>
                }
            </MudCardContent>

            @if (_isRawMode)
            {
                <MudCardActions Class="pb-4 pl-4" Style="background-color: rgba(63, 81, 181, 0.1);">
                    <MudButton StartIcon="@Icons.Material.Filled.Save"
                               Variant="Variant.Filled"
                               Color="Color.Primary"
                               Size="Size.Large"
                               OnClick="SaveFile">
                        Guardar YAML
                    </MudButton>
                </MudCardActions>
            }
        </MudCard>
    }
</MudContainer>

@code {
    // ---------------------------------------------------------
    // VIEW MODEL PARA DISPOSITIVOS
    // ---------------------------------------------------------
    public class DeviceViewModel
    {
        public string ID { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Alias { get; set; } = string.Empty;
        public string Make { get; set; } = string.Empty;
        public string Model { get; set; } = string.Empty;
        public string? SerialNumber { get; set; }

        // Mapeo especial para listas: Las manejamos como strings separadas por comas en la UI
        public string AltMakesString { get; set; } = string.Empty;
        public string AltModelsString { get; set; } = string.Empty;

        // Estado de la UI
        public bool ShowDetails { get; set; } = false;
        public bool IsNew { get; set; } = false;
    }

    private bool _isLoading = true;
    private string _filePath = "";
    private string _content = string.Empty;
    private List<DeviceViewModel> _devices = new();
    private bool _isRawMode = false;

    private DeviceViewModel? _elementBeforeEdit;

    protected override async Task OnInitializedAsync()
    {
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomRight;
        var configFolder = Configuration.GetValue<string>("ConfigFolder") ?? Path.Combine(AppDomain.CurrentDomain.BaseDirectory, "Config");
        _filePath = Path.Combine(configFolder, "Devices.yaml");

        await LoadFile();
        _isLoading = false;
    }

    private async Task LoadFile()
    {
        try
        {
            if (FileSystem.File.Exists(_filePath))
                _content = await FileSystem.File.ReadAllTextAsync(_filePath);
            else
                _content = "Devices:\n  - ID: Unknown\n    Name: Unknown Device\n    Alias: UNK\n    Make: 3rdParty\n    Model: Unknown";

            ParseYamlToObjects();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
    }

    private void OnModeChanged(bool isRaw)
    {
        if (isRaw) GenerateYamlFromObjects();
        else ParseYamlToObjects();

        _isRawMode = isRaw;
    }

    // --- CICLO DE VIDA EDICIÓN ---
    private void BackupItem(object element)
    {
        var device = (DeviceViewModel)element;
        _elementBeforeEdit = new DeviceViewModel
            {
                ID = device.ID,
                Name = device.Name,
                Alias = device.Alias,
                Make = device.Make,
                Model = device.Model,
                SerialNumber = device.SerialNumber,
                IsNew = device.IsNew
            };
    }

    private void ResetItemToOriginalValues(object element)
    {
        var device = (DeviceViewModel)element;

        if (device.IsNew)
            _devices.Remove(device);
        else if (_elementBeforeEdit != null)
        {
            device.ID = _elementBeforeEdit.ID;
            device.Name = _elementBeforeEdit.Name;
            device.Alias = _elementBeforeEdit.Alias;
            device.Make = _elementBeforeEdit.Make;
            device.Model = _elementBeforeEdit.Model;
            device.SerialNumber = _elementBeforeEdit.SerialNumber;
        }
        StateHasChanged();
    }

    private void ItemHasBeenCommitted(object element)
    {
        var device = (DeviceViewModel)element;
        device.IsNew = false;
        _ = AutoSave();
    }

    private void AddDevice()
    {
        var newDevice = new DeviceViewModel { ID = "", Name = "", Alias = "", Make = "", Model = "", IsNew = true };
        _devices.Insert(0, newDevice);
        StateHasChanged();
        Snackbar.Add("Haz clic en el icono del lápiz del nuevo registro para rellenarlo.", Severity.Info);
    }

    private async Task DeleteDevice(DeviceViewModel device)
    {
        _devices.Remove(device);
        _devices = _devices.ToList();
        await AutoSave();
    }

    // --- YAMLDOTNET ---
    private void ParseYamlToObjects()
    {
        try
        {
            var deserializer = new DeserializerBuilder().IgnoreUnmatchedProperties().Build();
            var root = deserializer.Deserialize<Dictionary<string, List<Device>>>(_content);
            if (root != null && root.ContainsKey("Devices") && root["Devices"] != null)
            {
                _devices = root["Devices"].Select(d => new DeviceViewModel
                    {
                        ID = d.ID ?? "",
                        Name = d.Name ?? "",
                        Alias = d.Alias ?? "",
                        Make = d.Make ?? "",
                        Model = d.Model ?? "",
                        SerialNumber = d.SerialNumber,
                        // Convertimos la Lista en string separado por comas
                        AltMakesString = d.AltMakes != null ? string.Join(", ", d.AltMakes) : "",
                        AltModelsString = d.AltModels != null ? string.Join(", ", d.AltModels) : ""
                    }).ToList();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error de sintaxis YAML: {ex.Message}", Severity.Warning);
            _isRawMode = true;
        }
    }

    private void GenerateYamlFromObjects()
    {
        var coreDevices = _devices.Select(v => new Device
            {
                ID = v.ID,
                Name = v.Name,
                Alias = v.Alias,
                Make = v.Make,
                Model = v.Model,
                SerialNumber = string.IsNullOrWhiteSpace(v.SerialNumber) ? null : v.SerialNumber,
                // Convertimos la string separada por comas de vuelta a Lista
                AltMakes = string.IsNullOrWhiteSpace(v.AltMakesString) ? new List<string>() : v.AltMakesString.Split(',').Select(s => s.Trim()).ToList(),
                AltModels = string.IsNullOrWhiteSpace(v.AltModelsString) ? new List<string>() : v.AltModelsString.Split(',').Select(s => s.Trim()).ToList()
            }).ToList();

        var root = new Dictionary<string, List<Device>> { { "Devices", coreDevices } };
        var serializer = new SerializerBuilder().ConfigureDefaultValuesHandling(DefaultValuesHandling.OmitNull).Build();
        _content = serializer.Serialize(root);
    }

    // --- GUARDADO ---
    private async Task AutoSave()
    {
        if (!_isRawMode) GenerateYamlFromObjects();
        try
        {
            await FileSystem.File.WriteAllTextAsync(_filePath, _content);
            Snackbar.Add("Guardado automático", Severity.Success, config => { config.VisibleStateDuration = 1500; });
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al auto-guardar: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveFile()
    {
        try
        {
            await FileSystem.File.WriteAllTextAsync(_filePath, _content);
            Snackbar.Add("¡YAML guardado correctamente!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error al guardar: {ex.Message}", Severity.Error);
        }
    }
}
