# Specify default ExifTool API options
# (see the Options function documentation for available options)
%Image::ExifTool::UserDefined::Options = (
		LargeFileSupport => 1,
		QuickTimeUTC => 1,
		Lang => es
	);
	

# CUSTOM NAMESPACE & COMPOSITE TAGS
%Image::ExifTool::UserDefined = (
	# CUSTOM TAGS - New XMP namespace must be added to the Main XMP table:
    'Image::ExifTool::XMP::Main' => {
        AMC => { # <-- must be the same as the NAMESPACE prefix
            SubDirectory => {
                TagTable => 'Image::ExifTool::UserDefined::AMC',
                # (see the definition of this table below)
            },
        },
        # add more user-defined XMP namespaces here...
    },

	# COMPOSITE TAGS
    'Image::ExifTool::Composite' => {
		#Hash
		MD5 => {
            Desire => {
                1 => 'ImageDataHash',
            },

            ValueConv => q{
                my $md5 = $val[0];
                return "${md5}";
            },
        },
		#Make by priority
		MyMake => {
            Desire => {
                0 => 'Make',
                1 => 'AndroidMake',
            },
            ValueConv => '$val[0] || $val[1]',
        },
		#Model by priority
		MyModel => {
            Desire => {
                0 => 'Model',
                1 => 'AndroidModel',
            },
            ValueConv => '$val[0] || $val[1]',
        },
		MySerialNumber => {
			Desire => {
				0 => 'InternalSerialNumber',
			},
			ValueConv => q{
	
				my $SerialNumber = CleanSerialNumber($val[0]);
				return "${SerialNumber}";
			},
		},
		MyAuthorName => {
			Require => {
				0 => 'MyModel',
				1 => 'MyDate',
			},
			Desire => {
				2 => 'MySerialNumber',
			},
			ValueConv => q{
				 my $author = GetAuthor($val[0], $val[1], $val[2]);
				 if ($author) {
					return $author->{'Name'};
				 }
			},
		},
        MyAuthorAlias => {
			Require => {
				0 => 'MyModel',
				1 => 'MyDate',
			},
			Desire => {
				2 => 'MySerialNumber',
			},
			ValueConv => q{
				 my $author = GetAuthor($val[0], $val[1], $val[2]);
				 if ($author) {
					return $author->{'Alias'};
				 }
			},
		},
		MyDeviceName => {
			Require => {
				0 => 'MyModel',
			},
			Desire => {
				1 => 'MySerialNumber',
			},
			ValueConv => q{
				my $device = GetDevice($val[0], $val[1]);
				if ($device) {
					return $device->{'Name'};
				}
			},
		},
		MyDeviceAlias => {
			Require => {
				0 => 'MyModel',
			},
			Desire => {
				1 => 'MySerialNumber',
			},
			ValueConv => q{
				my $device = GetDevice($val[0], $val[1]);
				if ($device) {
					return $device->{'Alias'};
				}
			},
		},
		
		#FileType

		IsVideo => {
			ValueConv => q{
				return $$self{VALUE}{FileTypeExtension} =~ /^(mp4|mov|3gp|avi|mkv|webm|flv)$/i ? 1 : 0;
			},
		},

		IsPhoto => {
			ValueConv => q{
				return $$self{VALUE}{FileTypeExtension} =~ /^(jpe?g|png|tif|tiff|cr2|nef|arw|rw2|raf)$/i ? 1 : 0;
			},
		},

		#Event
		MyAlbum => {
			Require => {
				0 => 'MyDate',
			},
			Desire => {
                1 => 'Album',
            },
            ValueConv => q{
				 my $date = $val[0];
				 my $AlbumOriginal = $val[1];
				 my $Album;
				 my $DefaultAlbumFolderName = "Moments";
				 
				 # Comprobar si el nodo de álbum tiene un valor definido en los metadatos
				 if ($AlbumOriginal) {
				 	$Album = $AlbumOriginal;
				 } else {
				 	# Si no hay valor, usar la convención predeterminada
				 	$self->Options(DateFormat => "%Y-%m");
					$date = $self->ConvertDateTime($date);
					$Album = "${date} ${DefaultAlbumFolderName}" #2021-01 Moments"
				 }

			     $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
			
				 return "${Album}";
			},
        },
		MyDecade => {
            Require => {
                0 => 'MyDate',
            },
            ValueConv => q{
				my $date = $val[0];
				$self->Options(DateFormat => "%Y");
				$date = $self->ConvertDateTime($date);
				$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				$date =~ s/\d$//;  #Remove last digit
                my $decade = "${date}0";
                return $decade;
            },
        },
		
		#Date by priority
		MyDate => {
			Desire => {
				0 => 'DateTimeOriginal',
				1 => 'CreateDate',
				2 => 'ModifyDate',
				3 => 'FileModifyDate',
				4 => 'DateTimeOriginalFromFileName',  # opcional, por si no hay metadatos
			},
			ValueConv => q{
				my $date;
				my $fallback; # para guardar FileModifyDate si nada más vale

				foreach my $v (@val) {
					next unless $v;                 # descarta undef
					next if $v =~ /^0000/;         # descarta fechas 0000
					if ($v =~ /^19[0-5]\d/) {      # años sospechosos
						$fallback = $v if !defined $fallback;
						next;
					}
					$date = $v;
					last;
				}

				# si no encontramos ninguna válida, usamos el fallback
				$date ||= $fallback || $val[3] || $val[4];

				$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				return $self->ConvertDateTime($date);
			},
		},

		MyShortMonthName => {
			Require => {
					0 => 'MyDate',
			},
			ValueConv => q{
				 my $date = $val[0];
				 $self->Options(DateFormat => "%b");
				 $date = $self->ConvertDateTime($date);
				 $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				 $date =~ s/(\b\w)/\u$1/g;  # Capitalizar la primera letra del mes
				 $date =~ s/\.//;           # Eliminar el punto del mes abreviado
				 return "${date}";
			},
		},
        MySubseconds => {
            ValueConv => q{
				my ($self) = @_;
				#SubSecTimeOriginal - Variable original subsegundos
				my $subsectimeoriginal = $self->GetValue('SubSecTimeOriginal');
				#SubsecondsFromFileName - Variable obtenida de nombre
				my $SubsecondsFromFileName = $self->GetValue('SubsecondsFromFileName');
				return GetSubSeconds($subsectimeoriginal, $SubsecondsFromFileName);
            },
        },
		SubsecondsFromFileName => {
			Desire => {
				0 => 'PreservedFileName',
				1 => 'FileName',
			},
            ValueConv => q{
				my $OriginalFileName = $val[0] || $val[1];
				my $TZReferencedDateTime = $self->GetValue('CreateDate');
				my ($date, $hour, $min, $sec, $subseconds) = GetDateTimeOriginalFromFileName($self, $OriginalFileName, $TZReferencedDateTime);
				return $subseconds;
            },
        },
		DateTimeOriginalStringFromFileName => {
			#Condition => 'not defined $$self{VALUE}{DateTimeOriginal} and $$self{VALUE}{FileTypeExtension} =~ /^(mp4|JPG)$/i',
			Desire => {
				0 => 'PreservedFileName',
				1 => 'FileName',
			},
			ValueConv => q{
				my $OriginalFileName = $val[0] || $val[1];
				my $TZReferencedDateTime = $self->GetValue('CreateDate');
				my ($date, $hour, $min, $sec, $subseconds) = GetDateTimeOriginalFromFileName($self, $OriginalFileName, $TZReferencedDateTime);
				
				return "$date $hour:$min:$sec.$subseconds";
			},
            #PrintConv => '$self->ConvertDateTime($val)',
		},
		DateTimeOriginalFromFileName => {
			#Condition => 'not defined $$self{VALUE}{DateTimeOriginal} and $$self{VALUE}{FileTypeExtension} =~ /^(mp4|JPG)$/i',
			Desire => {
				0 => 'PreservedFileName',
				1 => 'FileName',
			},
			ValueConv => q{
				my $OriginalFileName = $val[0] || $val[1];
				my $TZReferencedDateTime = $self->GetValue('CreateDate');
				my ($date, $hour, $min, $sec, $subseconds) = GetDateTimeOriginalFromFileName($self, $OriginalFileName, $TZReferencedDateTime);
				
				my $full_date = "$date $hour:$min:$sec";
				$self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				return $self->ConvertDateTime($full_date);
			},
            #PrintConv => '$self->ConvertDateTime($val)',
		},

		#Name convention
		MyFullFolderFileConvention => {
			Require => {
					0 => 'MyFolderConvention',
					1 => 'MyFileNameConvention',
			},
			ValueConv => q{
				 my $FolderConvention = $val[0];
				 my $FileNameConvention = $val[1];
				 #print "MyFullFolderFileConvention: ${FolderConvention}/${FileNameConvention}";
				 return "${FolderConvention}/${FileNameConvention}";
			},
		},
		MyFileNameConvention => {
			Require => {
					0 => 'MyDate',
					1 => 'MySubseconds',
					2 => 'MyModel',
					3 => 'MyAuthorAlias',
					4 => 'MyDeviceAlias',
			},
			Desire => {
				5 => 'MySerialNumber',
			},
			ValueConv => q{
				 my $date = $val[0];
				 my $Subseconds = $val[1];
				 my $model = $val[2];
				 my $AuthorAlias = $val[3];
				 my $DeviceAlias = $val[4];
				 my $serialNumber = $val[5];
				
				 
				 # Formatear la fecha
				 $self->Options(DateFormat => "%Y-%m-%d_%H-%M-%S");
				 $date = $self->ConvertDateTime($date);
				 $date =~ s/(\b\w)/\u$1/g;  # Capitalizar la primera letra del mes
				 $date =~ s/\.//;           # Eliminar el punto del mes abreviado
				 $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				 
				 return "${date}-${Subseconds}-${AuthorAlias}-${DeviceAlias}"; #YYYY-MM-DD_HH-mm-ss-mss_Author_Device(2024-03-01_19-02-48-050_AMC_PXL8P)
			},
		},
		MyFolderConvention => {
			Require => {
					0 => 'MyDate',
					1 => 'MyDecade',
					2 => 'MyShortMonthName',
					3 => 'MyAlbum',
			},
			ValueConv => q{
				 my $date = $val[0];
				 my $MyDecade = $val[1];
				 my $MyShortMonthName = $val[2];
				 my $Album = $val[3];
				 $self->Options(DateFormat => "%Y/%Y-%m");
				 $date = $self->ConvertDateTime($date);
				 $self->Options(DateFormat => "%Y:%m:%d %H:%M:%S"); # Reset DateFormat
				 return "${MyDecade}s/${date}-${MyShortMonthName}/${Album}"; #Y0s\YYYY\Year-MonthNumber-MyShortMonthName\Album (2020s\2021\2021-01-Jan\2021-01 Moments)
			},
		},
    },
);

# CUSTOM NAMESPACE DEFINITION (AMC)
# Define la estructura XMP anidada para ns.amarcobal.es/AMC/1.0/
#
%Image::ExifTool::UserDefined::AMC = (
    GROUPS => { 0 => 'XMP', 1 => 'XMP-AMC', 2 => 'Image' },
    NAMESPACE => { 'AMC' => 'http://ns.amarcobal.es/AMC/1.0/' },
    WRITABLE => 'string', # Todas las etiquetas serán de tipo string por defecto
    
    # ---------------------------------------------------------------------
    # ESTRUCTURA 1: IDENTITY
    # ---------------------------------------------------------------------
    Identity => {
        Struct => {
            # 1.1 Estructura Anidada: Author
            Author => {
                Struct => {
                    ID    => { Writable => 'string' }, # Ej: 'Adrian'
                    Alias => { Writable => 'string' }, # Ej: 'AMC'
                    Name  => { Writable => 'string' }, # Ej: 'Adrián Marcobal'
                },
            },
            
            # 1.2 Estructura Anidada: Device
            Device => {
                Struct => {
                    ID           => { Writable => 'string' }, # Ej: 'PXL8P'
                    Alias        => { Writable => 'string' }, # Ej: 'PXL8P'
                    Name         => { Writable => 'string' }, # Ej: 'Google Pixel 8 Pro'
                    SerialNumber => { Writable => 'string' },
                },
            },
        },
    }, # Fin de Identity

    # ---------------------------------------------------------------------
    # ESTRUCTURA 2: ORIGIN
    # ---------------------------------------------------------------------
    Origin => {
        Struct => {
            OriginalFileName  => { Writable => 'string' },
            OriginalFolder    => { Writable => 'string' },
        },
    }, # Fin de Origin

    # ---------------------------------------------------------------------
    # ESTRUCTURA 3: EVENT
    # Almacena información del evento al que pertenece la foto.
    # ---------------------------------------------------------------------
    Event => {
        Struct => {
            # 5.1 Nombre del evento principal/específico
            # Ej: "Nochevieja 2024" o "Visita al Museo Británico"
            Name => { Writable => 'string' },
            
            # 5.2 Rango de fechas. 
            # Para un solo día, StartDate y EndDate tienen el mismo valor.
            StartDate => { Writable => 'string' }, # Formato: 'YYYY-MM-DD'
            EndDate   => { Writable => 'string' }, # Formato: 'YYYY-MM-DD'
            
            # 5.3 Jerarquía de Padres (Ruta de texto)
            # El nivel más alto va primero.
            # Ej: "Vacaciones 2024|Viaje a Londres"
            HierarchyPath => {
                Writable => 'string',
            },
        },
    }, # Fin de Event
	
);

